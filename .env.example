# Copy to .env (python -m kit init does this).
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=qwiklabs-gcp-04-f8ba79cf4618
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_REGION=us-east1
MODEL=gemini-3-flash-preview

# Data
BQ_DATASET=a4i_climate
BQ_LOCATION=US

# Which domain definition drives prompts, schema docs, ML, tools
DOMAIN_FILE=domains/urban_heat/domain.yaml

# Deploy
AGENT_NAME=heat-planning-assistant

# Optional capabilities (flip to 1 when needed)
ENABLE_MAPS_MCP=0
REMOTE_A2A_CARD=
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
