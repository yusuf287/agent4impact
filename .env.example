# Copy to .env (bootstrap.sh does this). Then:  set -a; source .env; set +a
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_REGION=us-central1
MODEL=gemini-3-flash-preview

# Data
BQ_DATASET=foodbridge
BQ_LOCATION=US

# Which domain definition drives prompts, schema docs, ML, tools
DOMAIN_FILE=domains/food_equity/domain.yaml
VIEWS_SQL=domains/food_equity/views.sql
MODEL_SQL=domains/food_equity/model.sql

# Deploy
AGENT_NAME=foodbridge-analyst

# Optional capabilities (flip to 1 when needed)
ENABLE_MAPS_MCP=0
REMOTE_A2A_CARD=
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
